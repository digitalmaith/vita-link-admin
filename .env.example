# ==============================
# VITA-LINK ADMIN — ENV EXAMPLE
# Copier ce fichier en .env.local
# et remplir les valeurs réelles
# ==============================

# --- API ---
NEXT_PUBLIC_API_URL=https://vita-link-api.onrender.com/api

# --- Auth (NextAuth.js) ---
NEXTAUTH_SECRET=change-me-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# --- Maps (Heatmap Mapbox) ---
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Feature Flags ---
NEXT_PUBLIC_ENABLE_2FA=true
